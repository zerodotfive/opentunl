client
dev tun
proto udp
remote vpn.test.com 1194
cipher AES-256-GCM
auth SHA512
auth-nocache
#auth-user-pass
tls-version-min 1.2
tls-cipher "TLS-DHE-RSA-WITH-AES-256-GCM-SHA384:TLS-DHE-RSA-WITH-AES-256-CBC-SHA256:TLS-DHE-RSA-WITH-AES-128-GCM-SHA256:TLS-DHE-RSA-WITH-AES-128-CBC-SHA256:@SECLEVEL=0"
resolv-retry infinite
tun-mtu 1480
nobind
persist-key
persist-tun
mute-replay-warnings
verb 3
<ca>
{{ .CA -}}
</ca>
<cert>
{{ .Cert -}}
</cert>
<key>
{{ .Key -}}
</key>
